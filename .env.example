# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API Keys). Usa solo la clave PÚBLICA (publishable / anon), nunca la secreta.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# Cloudinary (subida de fotos): el "Cloud name" del Dashboard y el nombre del upload preset "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=